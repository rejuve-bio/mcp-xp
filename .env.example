# API keys and external services
OPENAI_API_KEY=
GEMINI_API_KEY=

# hugging face model names for cross encoder and local embedding model use.
CROSS_ENCODER=
HUGGINGFACE_MODEL=

# Current LLM model to run the galaxy MCP server with either [openai, gemini]
CURRENT_LLM=

# Current Embedding model to run the galaxy MCP server with either [openai, gemini, huggingface]
CURRENT_EMBEDDER=

# Galaxy URL and admin user api_key for galaxy integration.
GALAXY_URL=
GALAXY_API_KEY=

# App + service networking
APP_PORT=8895
MCP_PORT=8897

# Redis
REDIS_PORT=6389

# Qdrant vector DB
QDRANT_HOST=
QDRANT_HTTP_PORT=6555
QDRANT_GRPC_PORT=6556

# Mongo DB
MONGO_HOST=
MONGO_PORT=28018

# Fernet secret key for encryption and decryption.
SECRET_KEY=

# Login tokens from the platform's auth service (HS256). JWT_SECRET is the
# auth service's JWT_SECRET_KEY; comma-separate several to rotate or to accept
# a second auth deployment. JWT_VERIFY: enforce (default), report (log failing
# tokens but accept them; for rollout), off (local development only).
JWT_SECRET=
JWT_VERIFY=enforce

# Address(es) of the reverse proxy allowed to set X-Forwarded-For, so the
# access log shows real client addresses.
FORWARDED_ALLOW_IPS=127.0.0.1

# Data scraping url and token galaxy scraping url and github url.
GALAXY_SCRAPING_URL=
GALAXY_SCRAPING_API_KEY=
GITHUB_TOKEN=

# Neo4j connection variables for GraphRAG in the MCP server
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Dev host only: extra compose files (see docs/deploy.md, "Docker Compose dev host").
# COMPOSE_FILE=docker-compose.yml:docker-compose.file-service.yml
